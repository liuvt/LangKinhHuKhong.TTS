@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject VoiceService VoiceCatalog
@inject TextSplitterService Splitter
@inject RenderService Renderer
@inject PlaylistMergeService PlaylistMerger
@inject SessionOutputService Sessions
@inject IJSRuntime JS
@using LangKinhHuKhong.TTS.Models

<div class="site-shell">
    <header class="site-header">
        <div class="layout-wide header-inner">
            <a href="/" class="logo-lockup" aria-label="Lăng Kính Hư Không - trang chủ">
                <img src="/images/lang-kinh-hu-khong-logo.png" alt="Logo Lăng Kính Hư Không" />
                <span class="brand-copy"><strong>Lăng Kính <span>Hư Không</span></strong><small>STUDIO TTS OFFLINE</small></span>
            </a>
            <nav class="header-nav" aria-label="Điều hướng">
                <a href="#studio" class="current">Studio</a>
                <a href="#how-it-works">Hướng dẫn</a>
                <a href="#features">Tính năng</a>
            </nav>
            <div class="header-tools"><span class="server-status"><i></i> Offline engine</span><a class="header-cta" href="#studio">Tạo MP3 <span>↗</span></a></div>
        </div>
    </header>

    <main>
        <section class="hero layout-wide">
            <div class="hero-content">
                <div class="eyebrow"><span class="eyebrow-spark">✦</span> LĂNG KÍNH HƯ KHÔNG <span class="eyebrow-sep">/</span> AUDIO WORKSPACE <span class="eyebrow-version">v3.2</span></div>
                <h1>Biến văn bản thành <span>giọng nói</span> chỉ trong vài bước.</h1>
                <p class="hero-description">Công cụ tạo giọng đọc tiếng Việt cho truyện, video và nội dung sáng tạo. Nhập văn bản, chọn giọng, xuất MP3 — tất cả trên máy tính của bạn.</p>
                <div class="hero-benefits"><span><b>✓</b> Không cần tài khoản</span><span><b>✓</b> Xử lý nội bộ</span><span><b>✓</b> Xuất MP3</span></div>
            </div>
            <div class="hero-terminal" aria-label="Thông tin công cụ">
                <div class="terminal-top"><div class="traffic-lights"><i></i><i></i><i></i></div><span>Lăng Kính Hư Không / local-studio</span><span class="terminal-version">v3.2</span></div>
                <div class="terminal-body">
                    <div class="terminal-prompt"><span>➜</span> tts / generate</div>
                    <div><span class="terminal-key">nguồn</span><span class="terminal-value">Văn bản tiếng Việt</span></div>
                    <div><span class="terminal-key">giọng đọc</span><span class="terminal-value">@voices.Count model khả dụng</span></div>
                    <div><span class="terminal-key">đầu ra</span><span class="terminal-value terminal-accent">MP3 audio</span></div>
                    <div class="terminal-ready"><span class="ready-dot"></span> Sẵn sàng nhận nội dung <span class="terminal-cursor"></span></div>
                </div>
            </div>
        </section>

        <div class="main-layout layout-wide">
            <section id="studio" class="converter-card" aria-label="Studio chuyển văn bản thành giọng nói">
                <div class="card-accent"></div>
                <div class="studio-topline"><span><b class="topline-dot"></b> LĂNG KÍNH HƯ KHÔNG / TEXT TO AUDIO</span><span class="studio-badge"><i></i> LOCAL STUDIO <b>v3.2</b></span></div>
                <div class="studio-title-row">
                    <div><div class="step-label">01 <span>/ NHẬP NỘI DUNG</span></div><h2>Văn bản cần chuyển đổi</h2><p>Dán nội dung muốn chuyển thành âm thanh. Hỗ trợ tối đa 100.000 ký tự mỗi lần.</p></div>
                    <div class="character-counter" aria-live="polite"><strong id="lkh-char-count">0</strong><span> / 100.000 ký tự</span></div>
                </div>

                <div class="editor-wrap">
                    <div class="editor-toolbar"><span class="editor-language"><span class="editor-status-dot"></span> TEXT INPUT <span class="editor-lang">· Tiếng Việt</span></span><div class="editor-actions">
                        <input id="lkh-file-input" class="visually-hidden" type="file" accept=".txt,.md,text/plain,text/markdown" aria-label="Nhập file TXT hoặc MD" />
                        <label for="lkh-file-input" class="import-button">＋ Import TXT / MD</label>
                        <button id="lkh-normalize-button" type="button" title="Thêm dấu chấm cho dòng còn thiếu dấu kết câu">✦ Ngắt nhịp TTS</button>
                        <button id="lkh-paste-button" type="button" title="Dán văn bản từ clipboard">↧ Dán</button>
                        <button id="lkh-clear-button" type="button" title="Xóa toàn bộ nội dung">✕ Xóa</button>
                    </div></div>
                    <textarea id="lkh-editor" class="content-editor" aria-label="Nội dung văn bản chuyển thành giọng nói" spellcheck="false" placeholder="Nhập hoặc dán nội dung truyện, kịch bản, lời dẫn video hay bất kỳ văn bản tiếng Việt nào vào đây..."></textarea>
                    <div class="editor-bottom"><span><span class="keyboard-symbol">⌨</span> Import MD/TXT tự thêm dấu kết câu · Có thể chuẩn hóa văn bản dán</span><span id="lkh-word-count">0 từ</span></div>
                </div>
                <div class="counter-track" aria-hidden="true"><span id="lkh-counter-bar"></span></div>
                <div id="lkh-input-warning" class="message message-error" role="alert" hidden style="display:none">
                    <span class="message-icon">!</span><div><strong>Đã vượt giới hạn 100.000 ký tự</strong><p>Vượt <span id="lkh-excess-count">0</span> ký tự. Hãy rút ngắn nội dung để tạo MP3. Văn bản đã dán vẫn được giữ nguyên.</p></div>
                </div>
                <div id="lkh-editor-status" class="paste-status" role="status" hidden style="display:none"></div>

                <div class="divider-soft"></div>
                <div class="config-heading"><div><div class="step-label">02 <span>/ CÀI ĐẶT GIỌNG ĐỌC</span></div><h2>Tuỳ chỉnh âm thanh</h2><p>Chọn giọng phù hợp và tốc độ phát trước khi xuất tệp.</p></div><button type="button" class="refresh-button" @onclick="ReloadVoices" disabled="@busy"><span>↻</span> Quét lại giọng đọc</button></div>
                <div class="config-grid">
                    <div class="voice-settings">
                        <div class="field"><label>Nhóm giọng đọc</label><div class="gender-group" role="group" aria-label="Nhóm giọng đọc">
                            <button class="gender-option @(gender == "Nữ" ? "selected" : "")" type="button" @onclick='() => ChangeGender("Nữ")' disabled="@busy"><span class="gender-symbol">♀</span><span><strong>Nữ</strong><small>@FemaleCount model</small></span></button>
                            <button class="gender-option @(gender == "Nam" ? "selected" : "")" type="button" @onclick='() => ChangeGender("Nam")' disabled="@busy"><span class="gender-symbol">♂</span><span><strong>Nam</strong><small>@MaleCount model</small></span></button>
                            <button class="gender-option @(gender == "Khác" ? "selected" : "")" type="button" @onclick='() => ChangeGender("Khác")' disabled="@busy"><span class="gender-symbol">◇</span><span><strong>Khác</strong><small>@OtherCount model</small></span></button>
                        </div></div>
                        <div class="field"><label for="voice-select">Chọn model giọng</label><select id="voice-select" class="form-select" value="@SelectedVoiceKey" @onchange="OnVoiceSelect" disabled="@(busy || FilteredVoices.Count == 0)">
                                @if (FilteredVoices.Count == 0)
                                {
                                    <option value="">Chưa có model thuộc nhóm @gender</option>
                                }
                                @foreach (var voice in FilteredVoices)
                                {
                                    <option value="@voice.ModelPath">@FriendlyName(voice) @(voice.IsMultiSpeaker ? $"({voice.NumSpeakers} speakers)" : "")</option>
                                }
                            </select>
                            @if (SelectedVoice is not null)
                            {
                                <div class="field-help"><span class="small-check">✓</span> @SelectedVoice.Language <span class="field-separator">·</span> @SelectedVoice.Quality <span class="field-separator">·</span> @(SelectedVoice.IsMultiSpeaker ? $"{SelectedVoice.NumSpeakers} speakers" : "Sẵn sàng")</div>
                            }
                        </div>
                    </div>
                    <div class="audio-settings">
                        <div class="field"><label for="speed-select">Tốc độ phát video</label><select id="speed-select" class="form-select" @bind="speedKey" disabled="@busy">
                                <option value="0.25">0,25x — Rất chậm</option><option value="0.5">0,5x — Chậm</option><option value="0.75">0,75x — Hơi chậm</option><option value="1">1x — Mặc định</option><option value="1.25">1,25x — Hơi nhanh</option><option value="1.75">1,75x — Nhanh</option><option value="2">2x — Rất nhanh</option><option value="2.5">2,5x — Siêu nhanh</option><option value="3">3x — Cực nhanh</option>
                            </select><div class="field-help">Tốc độ sẽ được áp dụng trực tiếp khi tạo MP3.</div></div>
                        @if (SelectedVoice?.IsMultiSpeaker == true)
                        {
                            <div class="field field-speaker">
                                <label for="speaker-select">Người đọc (Speaker)</label>
                                <select id="speaker-select" class="form-select" @bind="speakerId" disabled="@busy">
                                    @foreach (var sp in SelectedVoice.Speakers)
                                    {
                                        <option value="@sp.Id">@sp.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="model-count"><span class="model-count-icon">♫</span><div><strong>@voices.Count giọng đọc đã nhận diện</strong><small>Nữ @FemaleCount <span>·</span> Nam @MaleCount <span>·</span> Khác @OtherCount</small></div></div>
                    </div>
                </div>

                @if (busy || error.Length != 0 || latest is not null || voices.Count == 0 || FilteredVoices.Count == 0)
                {
                    <section class="render-status" aria-live="polite">
                        @if (voices.Count == 0)
                        {
                            <div class="message message-warning"><span class="message-icon">i</span><div><strong>Chưa tìm thấy model giọng đọc</strong><p>Thêm cặp file <code>.onnx</code> và <code>.onnx.json</code> vào <code>Voices/Nữ</code>, <code>Voices/Nam</code> hoặc <code>Voices/Khác</code>, sau đó chọn Quét lại giọng đọc.</p></div></div>
                        }
                        else if (FilteredVoices.Count == 0)
                        {
                            <div class="message message-warning"><span class="message-icon">i</span><div>Nhóm <strong>@gender</strong> chưa có giọng đọc. Chọn nhóm khác hoặc thêm model.</div></div>
                        }
                        @if (busy)
                        {
                            <div class="progress-title"><span><span class="working-spinner"></span> @(merging ? "Đang ghép các MP3..." : "Đang tạo âm thanh...")</span><strong>@(merging ? $"{mergeOrder.Count} file" : $"{done} / {total} đoạn")</strong></div>
                            @if (merging)
                            {
                                <progress></progress>
                            }
                            else
                            {
                                <progress max="@Math.Max(1, total)" value="@done"></progress>
                            }
                            <p class="progress-help">Vui lòng giữ tab đang mở cho đến khi hoàn tất.</p>
                        }
                        @if (error.Length != 0)
                        {
                            <div class="message message-error" role="alert"><span class="message-icon">!</span><div><strong>Không thể hoàn tất</strong><p>@error</p></div></div>
                        }
                        @if (latest is not null)
                        {
                            <div class="success-content"><span class="success-icon">✓</span><div><strong>@(latest.IsMerged ? "Đã ghép MP3 thành công" : "Đã tạo MP3 thành công")</strong><p>Mã file: <code>@latest.JobId</code>. File đã được thêm vào danh sách bên dưới.</p></div><a class="btn download-button" href="@DownloadUrlFor(latest)" download>↓ Tải MP3</a></div>
                        }
                    </section>
                }

                <div class="action-panel"><div class="action-info"><span class="action-label"><i></i> THÔNG TIN XUẤT FILE</span><div><b>@Characters.ToString("N0")</b> ký tự <span>·</span> <b>@SpeedDisplay</b> <span>·</span> @(SelectedVoice is null ? "Chưa chọn giọng" : FriendlyName(SelectedVoice))</div></div><div class="action-buttons">
                    @if (busy)
                    {
                        <button class="btn btn-danger" type="button" @onclick="Cancel">@(merging ? "■ Dừng ghép" : "■ Dừng render")</button>
                    }
                    @if (!TooLong)
                    {
                        <button class="btn btn-primary" type="button" @onclick="RenderAsync" id="lkh-render-button" disabled="@(busy || readingEditor || Characters == 0 || SelectedVoice is null)"><span>✦</span> @(busy ? "Đang xử lý..." : "Tạo & tải MP3") <span>→</span></button>
                    }
                </div></div>
                <section class="history-section" aria-label="Danh sách MP3 hoàn tất trong tab này">
                    <div class="history-title"><div><span class="step-label">03 <span>/ THƯ VIỆN ÂM THANH CỦA TAB</span></span><h2>MP3 đã tạo <span class="history-total">@history.Count</span></h2><p>Nghe thử, tải về, xóa MP3 hoặc chọn những đoạn muốn ghép. Chỉ bạn trong tab này nhìn thấy danh sách của mình.</p></div></div>
                    @if (history.Count == 0)
                    {
                        <div class="history-empty"><span>♫</span><strong>Chưa có file MP3 nào</strong><p>Render ít nhất 2 đoạn rồi chọn các file muốn ghép.</p></div>
                    }
                    else
                    {
                        <div class="history-list">
                            @foreach (var item in history)
                            {
                                <article class="history-item @(mergeOrder.Contains(item.JobId) ? "history-picked" : "")" @key="item.JobId">
                                    <label class="history-pick" title="Chọn file để ghép" aria-label="Chọn @item.DisplayName để ghép">
                                        <input type="checkbox" checked="@mergeOrder.Contains(item.JobId)" disabled="@busy"
                                            @onchange="(ChangeEventArgs args) => ToggleMergeSelection(item.JobId, args.Value is bool chosen && chosen)" />
                                    </label>
                                    <div class="history-icon">@(item.IsMerged ? "♬" : "♫")</div>
                                    <div class="history-detail"><strong>@item.DisplayName</strong>
                                        @if (item.IsMerged)
                                        {
                                            <span class="history-merged-tag">Đã ghép @item.MergedParts đoạn</span>
                                        }
                                        <div class="history-meta">ID: <code title="@item.JobId">@item.JobId</code></div>
                                        <div class="history-meta">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") <span>·</span> @FormatSize(item.FileSize)
                                            @if (!item.IsMerged)
                                            {
                                                <span>·</span> @item.VoiceName <span>·</span> @($"{item.Speed:0.##}x") <span>·</span> @item.CharacterCount.ToString("N0") <text>ký tự</text>
                                            }
                                        </div>
                                    </div>
                                    <div class="history-actions">
                                        <button class="history-action" type="button" @onclick="() => TogglePlayer(item.JobId)" aria-expanded="@(playingJobId == item.JobId)">@(playingJobId == item.JobId ? "Ẩn nghe" : "▶ Nghe")</button>
                                        <a class="history-action history-save" href="@DownloadUrlFor(item)" download>↓ Tải</a>
                                        <button class="history-action history-remove" type="button" disabled="@busy" @onclick="() => RemoveHistory(item.JobId)" title="Xóa cả MP3 trên máy chủ">✕ Xóa</button>
                                    </div>
                                    @if (playingJobId == item.JobId)
                                    {
                                        <div class="history-player"><audio controls preload="none" src="@ListenUrlFor(item)">Trình duyệt không hỗ trợ phát MP3.</audio></div>
                                    }
                                </article>
                            }
                        </div>
                    }
                    @if (historyError.Length != 0)
                    {
                        <div class="message message-error history-feedback" role="alert"><span class="message-icon">!</span><div>@historyError</div></div>
                    }
                    <div class="merge-panel">
                        <div class="merge-panel-heading"><div><span class="step-label">04 <span>/ GHÉP MP3 THEO THỨ TỰ</span></span><h3>Tạo một audio dài</h3><p>Đánh dấu file ở thư viện, đổi thứ tự phát, đặt tên rồi ghép. MP3 nguồn vẫn được giữ nguyên.</p></div><span class="merge-count">@mergeOrder.Count đoạn đã chọn</span></div>
                        @if (mergeOrder.Count > 0)
                        {
                            <ol class="merge-queue">
                                @for (var i = 0; i < mergeOrder.Count; i++)
                                {
                                    var jobId = mergeOrder[i];
                                    var selectedEntry = history.FirstOrDefault(x => x.JobId == jobId);
                                    if (selectedEntry is null) continue;
                                    <li @key="jobId">
                                        <span class="merge-index">@(i + 1)</span><span class="merge-file" title="@selectedEntry.DisplayName">@selectedEntry.DisplayName</span>
                                        <div class="merge-order-actions">
                                            <button type="button" title="Chuyển đoạn lên" disabled="@(busy || i == 0)" @onclick="() => MoveMerge(jobId, -1)">↑</button>
                                            <button type="button" title="Chuyển đoạn xuống" disabled="@(busy || i == mergeOrder.Count - 1)" @onclick="() => MoveMerge(jobId, 1)">↓</button>
                                            <button type="button" title="Loại đoạn khỏi danh sách ghép" disabled="@busy" @onclick="() => ToggleMergeSelection(jobId, false)">✕</button>
                                        </div>
                                    </li>
                                }
                            </ol>
                        }
                        else
                        {
                            <div class="merge-no-selection">☰ Chưa chọn đoạn nào. Dùng ô vuông bên trái từng MP3 để chọn.</div>
                        }
                        <div class="merge-footer">
                            <div class="merge-name-wrap"><label for="lkh-merge-name">Tên file MP3 sau ghép</label><input id="lkh-merge-name" class="merge-name" placeholder="Ví dụ: Truyện chương 01 đến 10" maxlength="100" @bind="mergedTitle" @bind:event="oninput" disabled="@busy" /></div>
                            <div class="merge-footer-actions"><button type="button" class="history-action" @onclick="ClearMergeSelection" disabled="@(busy || mergeOrder.Count == 0)">Bỏ chọn tất cả</button><button type="button" class="btn btn-primary" disabled="@(busy || mergeOrder.Count < 2 || string.IsNullOrWhiteSpace(mergedTitle))" @onclick="MergeSelectedAsync">@(merging ? "Đang ghép..." : "♬ Ghép & thêm vào danh sách")</button></div>
                        </div>
                        @if (mergeError.Length > 0)
                        {
                            <div class="message message-error history-feedback" role="alert"><span class="message-icon">!</span><div>@mergeError</div></div>
                        }
                    </div>
                </section>
                <div class="privacy-notice">♧ Chỉ lưu MP3 trong phiên của tab này trên máy chủ local. Khi đóng tab/Chrome, hệ thống yêu cầu xóa file và lịch sử; nếu bị tắt đột ngột, bộ dọn file hết hạn sẽ xử lý.</div>
            </section>
        </div>

        <section class="how-section layout-wide" id="how-it-works"><div class="how-title"><div class="step-label">HƯỚNG DẪN SỬ DỤNG</div><h2>3 bước tạo giọng đọc.</h2><p>Quy trình tối giản dành cho người tạo nội dung.</p></div><div class="how-grid"><div><span class="how-no">01</span><h3>Dán văn bản</h3><p>Nhập, dán hoặc import TXT/MD. Chuẩn hóa ngắt câu tự động.</p></div><div><span class="how-no">02</span><h3>Chọn giọng đọc</h3><p>Chọn nhóm Nữ, Nam, Khác cùng model và tốc độ phù hợp.</p></div><div><span class="how-no">03</span><h3>Tải MP3</h3><p>Render giọng đọc, nghe lại, tải, xóa hoặc ghép nhiều MP3 theo thứ tự.</p></div></div></section>
        <section id="features" class="features-strip layout-wide"><span>● WORKFLOW / LOCAL FIRST</span><div><b>100.000 ký tự</b> mỗi lần xử lý <i>·</i> <b>3 nhóm giọng</b> quản lý linh hoạt <i>·</i> <b>MP3</b> sẵn sàng để dựng video</div></section>
    </main>
    <footer class="site-footer layout-wide"><div><img src="/images/lang-kinh-hu-khong-logo.png" alt="" /> <b>Lăng Kính Hư Không</b><span>© 2026 · Offline Voice Studio</span></div><p>Tạo nội dung tiếng Việt dễ dàng hơn.</p></footer>
</div>

@code {
    private string sessionId = Guid.NewGuid().ToString("N");
    private string sessionSecret = Guid.NewGuid().ToString("N");
    private List<RenderHistoryEntry> history = [];
    private readonly List<string> mergeOrder = [];
    private string mergedTitle = "";
    private string? playingJobId;
    private string historyError = "";
    private string mergeError = "";
    private bool merging;
    private RenderHistoryEntry? latest;
    private List<VoiceModel> voices = [];
    private string gender = "Nữ";
    private int characterCount;
    private int wordCount;
    private DotNetObjectReference<TTS>? editorCallback;
    private string speedKey = "1";
    private string error = "";
    private string? selectedModelPath;
    private int? speakerId;
    private int done;
    private int total = 1;
    private bool busy;
    private bool readingEditor;
    private CancellationTokenSource? renderCancellation;

    private int Characters => characterCount;
    private bool TooLong => Characters > RenderService.MaxCharacters;
    private int FemaleCount => voices.Count(v => v.Category == "Nữ");
    private int MaleCount => voices.Count(v => v.Category == "Nam");
    private int OtherCount => voices.Count(v => v.Category == "Khác");
    private List<VoiceModel> FilteredVoices => voices.Where(v => v.Category == gender).ToList();
    private VoiceModel? SelectedVoice => FilteredVoices.FirstOrDefault(v => v.ModelPath == selectedModelPath);
    private string SelectedVoiceKey => SelectedVoice?.ModelPath ?? "";
    private string SpeedDisplay => speedKey.Replace('.', ',') + "x";
    private string DownloadUrlFor(RenderHistoryEntry entry) =>
        $"/download/{sessionId}/{Uri.EscapeDataString(entry.Filename)}?key={sessionSecret}";
    private string ListenUrlFor(RenderHistoryEntry entry) =>
        $"/listen/{sessionId}/{Uri.EscapeDataString(entry.Filename)}?key={sessionSecret}";
    private static string FormatSize(long bytes) => bytes >= 1024 * 1024
        ? $"{bytes / 1048576.0:0.##} MB" : $"{bytes / 1024.0:0.#} KB";

    protected override void OnInitialized()
    {
        Sessions.Register(sessionId, sessionSecret);
        ReloadVoices();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            editorCallback = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("lkhStudio.register", sessionId, sessionSecret, editorCallback);
        }
    }

    // Sau reload, JavaScript kiểm tra sessionStorage và hỏi server nối lại đúng phiên/tab.
    [JSInvokable]
    public async Task<bool> RestoreSession(string previousId, string previousSecret)
    {
        var restored = false;
        await InvokeAsync(() =>
        {
            if (!Sessions.Resume(previousId, previousSecret)) return;
            Sessions.Close(sessionId, sessionSecret); // phiên mới tạm thời không còn dùng
            sessionId = previousId;
            sessionSecret = previousSecret;
            history = Sessions.GetHistory(sessionId, sessionSecret).ToList();
            mergeOrder.Clear();
            playingJobId = null;
            latest = history.FirstOrDefault();
            restored = true;
            StateHasChanged();
        });
        return restored;
    }

    // Chỉ đồng bộ SỐ ĐẾM (vài byte) lên Blazor. Không chuyển toàn bộ textarea
    // qua SignalR mỗi khi nhập hay dán: vượt ngưỡng ~32 KB sẽ làm mất kết nối.
    [JSInvokable]
    public Task UpdateEditorStats(int characters, int words) => InvokeAsync(() =>
    {
        characterCount = Math.Max(0, characters);
        wordCount = Math.Max(0, words);
        StateHasChanged();
    });

    private void ReloadVoices()
    {
        var previous = selectedModelPath;
        voices = VoiceCatalog.GetVoices();
        if (previous is not null && FilteredVoices.Any(v => v.ModelPath == previous))
            selectedModelPath = previous;
        else
            SelectPreferredVoice();
        VoiceChanged();
    }

    private void ChangeGender(string category)
    {
        gender = category;
        SelectPreferredVoice();
        VoiceChanged();
    }

    private void SelectPreferredVoice()
    {
        var options = FilteredVoices;
        selectedModelPath = (gender == "Nữ"
            ? options.FirstOrDefault(v =>
                (v.Name + v.ModelPath).Contains("ngochuyen", StringComparison.OrdinalIgnoreCase) ||
                (v.Name + v.ModelPath).Contains("ngọc huyền", StringComparison.OrdinalIgnoreCase) ||
                (v.Name + v.ModelPath).Contains("ngoc_huyen", StringComparison.OrdinalIgnoreCase))
            : null)?.ModelPath ?? options.FirstOrDefault()?.ModelPath;
    }

    private void OnVoiceSelect(ChangeEventArgs args)
    {
        selectedModelPath = args.Value?.ToString();
        VoiceChanged();
    }

    private void VoiceChanged() => speakerId = SelectedVoice?.IsMultiSpeaker == true
        ? SelectedVoice.Speakers.FirstOrDefault()?.Id ?? 0 : null;

    private static string FriendlyName(VoiceModel voice)
    {
        var key = (voice.Name + " " + Path.GetFileNameWithoutExtension(voice.ModelPath)).ToLowerInvariant();
        if (key.Contains("ngochuyennew")) return "Ngọc Huyền New";
        if (key.Contains("ngochuyen")) return "Ngọc Huyền";
        if (key.Contains("ngocngan")) return "Ngọc Ngạn";
        if (key.Contains("manhdung")) return "Mạnh Dũng";
        if (key.Contains("taian")) return "Tài An";
        if (key.Contains("maiphuong")) return "Mai Phương";
        if (key.Contains("phuongtrang")) return "Phương Trang";
        if (key.Contains("mytam")) return "Mỹ Tâm";
        return voice.Name;
    }

    private async Task RenderAsync()
    {
        var voice = SelectedVoice;
        if (voice is null || busy || readingEditor) return;

        readingEditor = true;
        // Chỉ lấy text ở thời điểm bấm render; JS từ chối gửi nếu > 100.000 ký tự.
        // Dùng kiểm tra phía máy chủ như hàng rào thứ hai, tránh vượt giới hạn.
        string input;
        try { input = await JS.InvokeAsync<string>("lkhStudio.getEditorText"); }
        catch (JSException ex)
        {
            error = ex.Message.Contains("100000", StringComparison.Ordinal)
                ? "Nội dung vượt quá 100.000 ký tự. Vui lòng rút ngắn trước khi tạo MP3."
                : "Không thể đọc nội dung trong trình duyệt: " + ex.Message;
            return;
        }
        finally { readingEditor = false; }

        characterCount = Splitter.CharacterCount(input);
        wordCount = Splitter.WordCount(input);
        if (TooLong)
        {
            error = "Nội dung vượt quá 100.000 ký tự. Vui lòng rút ngắn trước khi tạo MP3.";
            return;
        }
        if (string.IsNullOrWhiteSpace(input))
        {
            error = "Vui lòng nhập nội dung trước khi tạo MP3.";
            return;
        }

        busy = true;
        latest = null;
        error = "";
        done = 0;
        total = 1;
        renderCancellation = new CancellationTokenSource();
        try
        {
            var speed = double.Parse(speedKey, System.Globalization.CultureInfo.InvariantCulture);
            var progress = new Progress<(int done, int total)>(p =>
            {
                done = p.done;
                total = p.total;
                _ = InvokeAsync(StateHasChanged);
            });
            latest = await Renderer.RenderAsync(input, voice, speed, speakerId, sessionId, sessionSecret, progress, renderCancellation.Token);
            history = Sessions.GetHistory(sessionId, sessionSecret).ToList();
            try
            {
                // Chỉ gọi một lần sau khi RenderAsync thực sự hoàn tất.
                await JS.InvokeVoidAsync("lkhStudio.download", DownloadUrlFor(latest));
            }
            catch (JSException)
            {
                error = "Trình duyệt không tự động tải tệp. Hãy chọn 'Tải MP3' bên dưới.";
            }
        }
        catch (OperationCanceledException) { error = "Đã dừng quá trình tạo MP3."; }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            busy = false;
            renderCancellation?.Dispose();
            renderCancellation = null;
        }
    }

    private void TogglePlayer(string jobId) => playingJobId = playingJobId == jobId ? null : jobId;

    private void ToggleMergeSelection(string jobId, bool chosen)
    {
        if (busy) return;
        if (chosen && history.Any(e => e.JobId == jobId) && !mergeOrder.Contains(jobId)) mergeOrder.Add(jobId);
        if (!chosen) mergeOrder.Remove(jobId);
        mergeError = "";
    }

    private void MoveMerge(string jobId, int offset)
    {
        if (busy) return;
        var oldIndex = mergeOrder.IndexOf(jobId);
        var newIndex = oldIndex + offset;
        if (oldIndex < 0 || newIndex < 0 || newIndex >= mergeOrder.Count) return;
        (mergeOrder[oldIndex], mergeOrder[newIndex]) = (mergeOrder[newIndex], mergeOrder[oldIndex]);
    }

    private void ClearMergeSelection()
    {
        if (busy) return;
        mergeOrder.Clear();
        mergeError = "";
    }

    private void RemoveHistory(string jobId)
    {
        if (busy) return;
        historyError = "";
        try
        {
            Sessions.RemoveFile(sessionId, sessionSecret, jobId);
            history = Sessions.GetHistory(sessionId, sessionSecret).ToList();
            mergeOrder.Remove(jobId);
            if (playingJobId == jobId) playingJobId = null;
            if (latest?.JobId == jobId) latest = null;
        }
        catch (Exception ex) { historyError = ex.Message; }
    }

    private async Task MergeSelectedAsync()
    {
        if (busy || mergeOrder.Count < 2) return;
        merging = true;
        busy = true;
        mergeError = "";
        historyError = "";
        latest = null;
        renderCancellation = new CancellationTokenSource();
        // Lưu thứ tự trước await để danh sách không bị thay đổi khi đang xử lý.
        var orderedIds = mergeOrder.ToArray();
        try
        {
            var output = await PlaylistMerger.MergeAsync(sessionId, sessionSecret,
                orderedIds, mergedTitle, renderCancellation.Token);
            latest = output;
            history = Sessions.GetHistory(sessionId, sessionSecret).ToList();
            mergeOrder.Clear();
            mergedTitle = "";
            try { await JS.InvokeVoidAsync("lkhStudio.download", DownloadUrlFor(output)); }
            catch (JSException) { mergeError = "Đã ghép thành công. Nhấn nút Tải trong thư viện để tải file."; }
        }
        catch (OperationCanceledException) { mergeError = "Đã dừng ghép MP3."; }
        catch (Exception ex) { mergeError = ex.Message; }
        finally
        {
            merging = false;
            busy = false;
            renderCancellation?.Dispose();
            renderCancellation = null;
        }
    }

    private void Cancel() => renderCancellation?.Cancel();

    public ValueTask DisposeAsync()
    {
        renderCancellation?.Cancel();
        // Không dọn ở DisposeAsync: Blazor có thể ngắt circuit tạm thời khi tab vẫn mở.
        // JavaScript pagehide và heartbeat/TTL sẽ quản lý tuổi thọ tab.
        editorCallback?.Dispose();
        return ValueTask.CompletedTask;
    }
}
